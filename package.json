{
  "name": "dsh-balance-bar",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Web plugin: a live account-balance vertical bar pinned to the right edge of the GUI.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "balance",
    "web-ui"
  ],
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node scripts/client-spec.mjs && node scripts/client-smoke.mjs",
    "test:host": "node scripts/balance-smoke.mjs",
    "verify": "node scripts/verify-deployed.mjs",
    "install:profile": "node scripts/install.mjs"
  }
}
